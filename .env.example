# Model provider: ollama or groq
MODEL_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud inference
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=

# Document and index storage
DOCUMENT_SOURCE=local
INDEX_SOURCE=local
FAISS_INDEX_PATH=artifacts/faiss

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=factoryassist5a797891
AZURE_BLOB_CONTAINER=manufacturing-docs
AZURE_FAISS_CONTAINER=faiss-index

# Token limits
MAX_QUESTION_TOKENS=256
MAX_CONTEXT_TOKENS=2000
MAX_INPUT_TOKENS=3000
MAX_OUTPUT_TOKENS=384

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
